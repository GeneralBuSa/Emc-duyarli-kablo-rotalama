{"nodes": [{"id": "readme_en_wire_harness_routing_demo", "label": "Wire Harness Routing Demo (English README)", "file_type": "document", "source_file": "README.en.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simplified prototype of EMC-aware aircraft wire harness routing on 3D fuselage geometry; goal is to show correct problem understanding and a testable modular skeleton, every result measured by checks independent of routing code."}, {"id": "readme_en_fuselage_mesh", "label": "Half-Cylinder Fuselage Mesh", "file_type": "concept", "source_file": "README.en.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_en_keepout_volumes_clearance", "label": "Keep-out Volumes and Clearance", "file_type": "concept", "source_file": "README.en.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nodes inside grown volumes and edges crossing them are removed from the graph, so keep-out/clearance violations are zero by construction; a no-clearance baseline yields 69 violations to prove the check works."}, {"id": "readme_en_emc_separation", "label": "EMC Separation Distance", "file_type": "concept", "source_file": "README.en.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_en_edge_capacity", "label": "Edge Capacity K", "file_type": "concept", "source_file": "README.en.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "K=2 is deliberately tight so the constraint is active; it lowers the bundling ratio of method e."}, {"id": "readme_en_min_bend_radius", "label": "Minimum Bend Radius", "file_type": "concept", "source_file": "README.en.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "